/*Pratica "Faça um programa que leia o nome de um vendedor, o seu salário fixo e o total de vendas efetuadas por ele no mês (em dinheiro). Sabendo que este vendedor ganha 15% de comissão sobre suas vendas efetuadas, informar o total a receber no final do mês, com duas casas decimais." feito em 09/2025*/

import java.util.Scanner;
public class Main{
  public static void main(String[] args){
  Scanner sc = new Scanner(System.in);

   String vendedor;
   double salarioFixo;
   double totalVendas;

   vendedor = sc.next();
   salarioFixo = sc.nextDouble();
   totalVendas = sc.nextDouble();
   salarioFixo = salarioFixo + (totalVendas * 0.15);
   System.out.printf("TOTAL = R$ %.2f%n",salarioFixo);
    
    sc.close();
  }
}

/*Pratica "Escreva um programa que leia o número de um funcionário, seu número de horas trabalhadas, o valor que recebe por hora e calcula o salário desse funcionário. A seguir, mostre o número e o salário do funcionário, com duas casas decimais." feito em 09/2025*/

import java.util.Scanner;
public class Main{
  public static void main(String[] args){
  Scanner sc = new Scanner(System.in);

   int funcionario;
   int horasT;
   double valorH;

  funcionario = sc.nextInt();
  horasT = sc.nextInt();
  valorH = sc.nextDouble();

  System.out.println("NUMBER = " + funcionario);
  System.out.printf("SALARY = U$ %.2f%n", horasT * valorH);

    sc.close();
  }
}
